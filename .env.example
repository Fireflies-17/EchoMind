# Required only when running pyannote speaker diarization.
# Create a Hugging Face token and accept the pyannote model terms on Hugging Face.
HF_TOKEN=

# Optional OpenAI-compatible chat completions endpoint for structured summaries.
# If these are left empty, the project writes a deterministic extractive summary.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120

# Qwen / Alibaba Cloud Model Studio uses an OpenAI-compatible endpoint.
# China Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
# International Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# US Virginia: https://dashscope-us.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=

# Optional embedding model. BAAI/bge-small-zh-v1.5 is small and works well for Chinese POC.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Windows 上 ModelScope 的全局文件锁偶尔会残留；项目默认在单进程 ASR 中关闭它。
MODELSCOPE_HUB_FILE_LOCK=false
